DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vcraft

# Random secret of at least 32 characters. Generate separately per environment.
SESSION_SECRET=
# Absolute persistent directory. Required in production.
MEDIA_STORAGE_DIR=
# Public origin (optionally with a base path) embedded in batch QR codes,
# e.g. https://vcraft.example.vn. Required to download QR images.
PUBLIC_APP_URL=
